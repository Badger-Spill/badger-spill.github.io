import Alert from "../components/Alert.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const trainingDates: string[] = [
  "Training #1 — September 3rd @ 6-7PM; Sac Caucus Room",
  "Training #2 — September 21st @ 5-6PM; Sac Caucus Room",
  "Training #3 — September 30th @ 5-6PM; Sac Caucus Room 4210",
  "Training #4 — October 21st @ 5-6PM; Sac Hearing Room",
  "Training #5 — November 16th @ 5:30-6:30PM; Sac Caucus Room 4001",
];
---
<BaseLayout>
  <h1 class="font-display text-3xl font-bold tracking-tight text-[#43729a] sm:text-5xl p-1 text-center">
    Get Involved
  </h1>
  <div class="flex justify-center mt-6">
    <Alert>
      <h3 class="font-bold mb-3 text-[#43729a]">Sign up here to RSVP to an upcoming Badger SPILL training!</h3>
      <p class="mb-4">
        <a class="underline text-[#43729a] font-semibold" href="https://docs.google.com/forms/d/e/1FAIpQLSeCvhSSISZZmUfP462VtmI9F-T2L9PKjAkoa72F6WHzBykdhA/viewform">Click here to RSVP →</a>
      </p>
      <h3 class="font-bold mb-3 text-[#43729a]">Here are our training dates! These will be finalized early/mid-August 😊</h3>
      <ul class="list-disc list-inside mb-3 text-[#43729a]">
        {trainingDates.map((date) => <li>{date}</li>)}
      </ul>
      <a class="underline text-[#43729a]" href="https://www.instagram.com/badger.spill/">Follow our Instagram for the most up-to-date information on training dates!</a>
    </Alert>
  </div>
  <article class="mx-auto mt-6 prose prose-zinc lg:prose-xl">
    <h3 class="font-display text-[#43729a]">How do I sign up to volunteer?</h3>
    <p class="text-[#43729a]">We'd love to hear from you! If you are interested in joining or have questions, please email <a href="mailto:membership.badgerspill@gmail.com" class="text-[#43729a] underline">membership.badgerspill@gmail.com</a>. If you are an RSO/organization leader interested in receiving student supporter training for your group, please fill out <a href="https://docs.google.com/forms/d/e/1FAIpQLScKKnA2r2mnGg5bRGRgXnfucWe-ghcgKlbQEcuW_f2__5Iq8A/viewform" class="text-[#43729a] underline">this request form</a> to be contacted by one of our trainers.</p>
    <h3 class="font-display text-[#43729a]">What is a student supporter?</h3>
    <p class="text-[#43729a]">A Student Supporter is a trained volunteer who provides peer support through compassionate listening, drawing from their own experiences, and providing thoughtful responses. Student Supporters anonymously respond to Spills submitted by UW–Madison students, offering a supportive written response and providing Spillers with relevant resources referrals.</p>
    <h3 class="font-display text-[#43729a]">What is the time commitment?</h3>
    <p class="text-[#43729a]">Student Supporters complete a one-time, hour-long in-person training session. After training, onboarding and responding to Spills are done entirely online. Student Supporters can expect to receive approximately one Spill every week or two.</p>
  </article>
</BaseLayout>
