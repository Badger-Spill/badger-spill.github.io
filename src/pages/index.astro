import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Slideshow from "../components/Slideshow.astro";
import madisonImage from "../assets/madison.jpg";
import Input from "../components/Input.astro";
import Textarea from "../components/Textarea.astro";
import Button from "../components/Button.astro";
import Alert from "../components/Alert.astro";
import Accordion from "../components/Accordion.astro";

const FORM_SUBMISSIONS_DISABLED = true;
const DISABLED_MESSAGE = "Badger Spill is on break and not currently accepting spills. You're welcome to visit our resources page! For inquiries, email president.badgerspill@gmail.com.";
---

<BaseLayout includeCaptcha={true}>
  <section class="mb-16 max-w-10xl mx-auto" id="slideshow">
    <Slideshow images={[{ src: madisonImage, alt: "Madison capitol" }]} />
  </section>
  

<section id="hero" class="text-center max-w-3xl mx-auto mb-10">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    Need to vent to a fellow Badger?
    <span class="bg-gradient-to-r from-primary-300 to-primary-400 bg-clip-text">Spill it!</span>
  </h1>

  <section class="text-center max-w-2xl mx-auto my-12">
    <p class="text-lg italic text-[#43729a]">"It felt good to write down my thoughts to an anonymous person that would have a really unbiased opinion."</p>
    <p class="mt-2 text-sm text-[#43729a] opacity-75">— Badger Spill user, 9.2/10 average satisfaction rating</p>
  </section>
  <div class="mt-6">
   <a href="/spill" class="inline-block rounded-full bg-[#43729a] px-8 py-3 text-white font-semibold hover:bg-[#365c7d] transition">
      Start spilling →
    </a> 
  </div>
</section>

<section class="max-w-6xl mx-auto mb-16 grid md:grid-cols-2 gap-10 md:gap-0 md:divide-x-2 md:divide-[#43729a]/30">

  <!-- Left: SPILL definition -->
  <div class="md:pr-10 text-left">
    <h2 class="font-display text-2xl font-bold mb-4">What is SPILL?</h2>
    <h3 class="text-base leading-relaxed text-[#43729a] text-font-semibold">
      SPILL stands for Supportive Peers in Laidback Listening. Established at
      UW–Madison in 2009, Badger SPILL now operates as a program of Badger
      Supports at the University of Wisconsin–Madison that provides
      confidential, peer-to-peer support. Any UW–Madison student can
      anonymously "spill" or vent about what they're going through—whether
      it's homesickness, roommate troubles, academic stress, relationships,
      or anything else on their mind. Within 48 hours, they'll receive 4–6
      personalized responses from trained SPILL Students.
      
      <br>
      <br>
      Badger SPILL is no longer an RSO on the UW Madison campus, but is operating as a program with Badger Supports, a different RSO.
     
    </h3>
  </div>

  <!-- Right: How a Spill is Processed, as a flowchart -->
  <div class="md:pl-10 text-left">
    <h2 class="font-display text-2xl font-bold mb-6">How a Spill is Processed</h2>

    <div class="flex flex-col">
      <div class="flex gap-4">
        <div class="flex flex-col items-center">
          <div class="w-9 h-9 rounded-full bg-[#43729a] text-white flex items-center justify-center font-bold text-sm">1</div>
          <div class="w-0.5 flex-1 bg-[#43729a]/30 my-1"></div>
        </div>
        <div class="pb-8">
          <h3 class="font-semibold">Submit a Spill</h3>
          <p class="text-sm mt-1">A UW–Madison student anonymously submits a Spill through the SPILL website.</p>
        </div>
      </div>

      <div class="flex gap-4">
        <div class="flex flex-col items-center">
          <div class="w-9 h-9 rounded-full bg-[#43729a] text-white flex items-center justify-center font-bold text-sm">2</div>
          <div class="w-0.5 flex-1 bg-[#43729a]/30 my-1"></div>
        </div>
        <div class="pb-8">
          <h3 class="font-semibold">Screen &amp; Categorize</h3>
          <p class="text-sm mt-1">A SPILL Response Coordinator screens the Spill for urgency and removes any identifying information to maintain confidentiality.</p>
        </div>
      </div>

      <div class="flex gap-4">
        <div class="flex flex-col items-center">
          <div class="w-9 h-9 rounded-full bg-[#43729a] text-white flex items-center justify-center font-bold text-sm">3</div>
          <div class="w-0.5 flex-1 bg-[#43729a]/30 my-1"></div>
        </div>
        <div class="pb-8">
          <h3 class="font-semibold">Match with Student Supporters</h3>
          <p class="text-sm mt-1">If the Spill is categorized as non-urgent, it is sent to trained Student Supporters who have indicated they are comfortable responding to or have experience with similar topics.</p>
        </div>
      </div>

      <div class="flex gap-4">
        <div class="flex flex-col items-center">
          <div class="w-9 h-9 rounded-full bg-[#43729a] text-white flex items-center justify-center font-bold text-sm">4</div>
        </div>
        <div>
          <h3 class="font-semibold">Receive Support</h3>
          <p class="text-sm mt-1">Within 48 hours, the Spiller (that's you!) receives 4–6 supportive responses from Student Supporters through their Wisc email.</p>
        </div>
      </div>
    </div>
  </div>
</section>

  <section class="mt-16 flex flex-col gap-4 max-w-3xl mx-auto">
    <div class="grid sm:grid-cols-2 gap-6 justify-center justify-items-center">
      <div class="rounded-xl border-2 border-[#43729a] bg-white/60 p-6 w-full max-w-sm">
        <h3 class="font-display text-lg font-bold mb-4 flex items-center gap-2">
          <span class="text-green-600">✓</span> What SPILL provides
        </h3>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2">
            <span class="text-green-600 mt-0.5">✓</span>
            <span>A one-time written peer support</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-600 mt-0.5">✓</span>
            <span>Empathetic, listening ear and helpful suggestions and resources from UW-Madison students</span>
          </li>
        </ul>
      </div>

      <div class="rounded-xl border-2 border-[#43729a] bg-white/60 p-6 w-full max-w-sm">
        <h3 class="font-display text-lg font-bold mb-4 flex items-center gap-2">
          <span class="text-red-500">✕</span> What SPILL doesn't provide
        </h3>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2">
            <span class="text-red-500 mt-0.5">✕</span>
            <span>Clinical or professional support</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-500 mt-0.5">✕</span>
            <span>Mental health diagnosis</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-500 mt-0.5">✕</span>
            <span>Emergency services</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-500 mt-0.5">✕</span>
            <span>Ongoing monitoring or follow-ups</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>