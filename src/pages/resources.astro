import BaseLayout from "../layouts/BaseLayout.astro";

type Resource = { label: string; url?: string; category: string; scope: "Local" | "National" };

const resources: Resource[] = [
  { label: "Suicide and Crisis Lifeline (call or text 988)", category: "Crisis", scope: "Local" },
  { label: "Dane County Crisis Line (608-280-2600)", category: "Crisis", scope: "Local" },
  { label: "UHS Crisis Line (608-265-5600, option 9)", category: "Crisis", scope: "Local" },
  { label: "Dane County Rape Crisis Center", url: "https://www.danecountyrcc.org", category: "Crisis", scope: "Local" },
  { label: "SAMHSA", url: "https://www.samhsa.gov", category: "Crisis", scope: "National" },
  { label: "National Helpline (1-800-662-4357)", category: "Crisis", scope: "National" },
  { label: "Disaster/Distress Hotline (1-800-985-5990)", category: "Crisis", scope: "National" },
  { label: "Domestic Abuse Intervention Services", url: "http://www.abuseintervention.org", category: "Crisis", scope: "Local" },
  { label: "The Trevor Project", url: "https://www.thetrevorproject.org/", category: "Crisis", scope: "National" },
  { label: "Trans Lifeline (877-565-8860)", category: "Crisis", scope: "National" },

  { label: "L&S Career Center", url: "https://successworks.wisc.edu/", category: "Academics", scope: "Local" },
  { label: "UHS Counseling", url: "https://www.uhs.wisc.edu/mental-health/individual/", category: "Academics", scope: "Local" },
  { label: "GUTS Tutoring", url: "https://www.guts.wisc.edu/", category: "Academics", scope: "Local" },
  { label: "The Writing Center", url: "https://writing.wisc.edu/", category: "Academics", scope: "Local" },
  { label: "Career Services", url: "https://careers.wisc.edu", category: "Academics", scope: "Local" },
  { label: "Rate My Professor", url: "https://www.ratemyprofessors.com/", category: "Academics", scope: "National" },
  { label: "Chegg", url: "https://www.chegg.com/", category: "Academics", scope: "National" },

  { label: "UHS Mental Health Counseling", url: "https://www.uhs.wisc.edu/mental-health/", category: "Mental Health", scope: "Local" },
  { label: "UHS Let's Talk", url: "https://www.uhs.wisc.edu/wellness/lets-talk/", category: "Mental Health", scope: "Local" },
  { label: "NAMI UW", url: "https://www.namiuw.org/", category: "Mental Health", scope: "Local" },
  { label: "National Institute for Mental Health", url: "https://www.nimh.nih.gov/health", category: "Mental Health", scope: "National" },
  { label: "National Alliance on Mental Illness", url: "https://www.nami.org/Home", category: "Mental Health", scope: "National" },
  { label: "The Steve Fund", url: "https://stevefund.org/", category: "Mental Health", scope: "National" },

  { label: "Multicultural Student Center", url: "https://www.msc.wisc.edu", category: "BIPOC", scope: "Local" },
  { label: "Diversity and Equity at UW", url: "https://diversity.wisc.edu/", category: "BIPOC", scope: "Local" },
  { label: "Wisconsin Involvement Network", url: "https://win.wisc.edu/", category: "BIPOC", scope: "Local" },
  { label: "Mental Health America BIPOC Resources", url: "https://www.mhanational.org/bipoc", category: "BIPOC", scope: "National" },
  { label: "Black Lives Matter", url: "https://blacklivesmatter.com/", category: "BIPOC", scope: "National" },
  { label: "Center for Native American Youth", url: "https://www.cnay.org/", category: "BIPOC", scope: "National" },

  { label: "Gender and Sexuality Campus Center", url: "https://lgbt.wisc.edu/", category: "LGBTQIA+", scope: "Local" },
  { label: "OutReach Community Center", url: "https://www.outreachmadisonlgbt.org/", category: "LGBTQIA+", scope: "Local" },
  { label: "LGBT National Help Center", url: "https://lgbthotline.org/", category: "LGBTQIA+", scope: "National" },
  { label: "PFLAG", url: "https://pflag.org/", category: "LGBTQIA+", scope: "National" },
  { label: "It Gets Better Project", url: "https://itgetsbetter.org/", category: "LGBTQIA+", scope: "National" },

  { label: "UHS Group Counseling", url: "https://www.uhs.wisc.edu/mental-health/group-counseling/", category: "Grief & Loss", scope: "Local" },
  { label: "UHS Grief Resources", url: "https://www.uhs.wisc.edu/grief-resources/", category: "Grief & Loss", scope: "Local" },
  { label: "Grief Share", url: "https://www.griefshare.org/", category: "Grief & Loss", scope: "National" },
  { label: "Agrace Grief Support", url: "https://www.agrace.org/grief-support/griefgroups/", category: "Grief & Loss", scope: "National" },

  { label: "UW-Madison Bias Reporting", url: "https://doso.students.wisc.edu/report-an-issue/bias-or-hate-reporting/", category: "Discrimination", scope: "Local" },
  { label: "UWPD", url: "https://uwpd.wisc.edu/", category: "Discrimination", scope: "Local" },
  { label: "International Student Services", url: "https://iss.wisc.edu/", category: "Discrimination", scope: "Local" },
  { label: "Race Forward", url: "https://www.raceforward.org/", category: "Discrimination", scope: "National" },
  { label: "NAACP", url: "https://naacp.org/", category: "Discrimination", scope: "National" },
  { label: "Stop AAPI Hate", url: "https://stopaapihate.org/", category: "Discrimination", scope: "National" },
];

const categories = [
  { name: "Academics", icon: "📚" },
  { name: "Mental Health", icon: "🧠" },
  { name: "BIPOC", icon: "🤝" },
  { name: "LGBTQIA+", icon: "🏳️‍🌈" },
  { name: "Grief & Loss", icon: "💐" },
  { name: "Discrimination", icon: "⚖️" },
];
---

<BaseLayout>
  <div class="text-center mb-12">
    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">
      Looking for resources?
    </h1>
    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">
      We got 'em.
    </h1>
  </div>

  <div class="rounded-xl border-2 border-[#43729a] bg-[#43729a]/10 p-6 mb-12 max-w-4xl mx-auto">
    <h2 class="font-display text-xl font-bold mb-3">🚨 Crisis Resources</h2>
    <ul class="grid sm:grid-cols-2 gap-2 text-sm list-disc list-inside">
      <li>Suicide and Crisis Lifeline — call or text 988</li>
      <li>Dane County Crisis Line — 608-280-2600</li>
      <li>UHS Crisis Line — 608-265-5600, option 9</li>
      <li>911 for immediate danger</li>
    </ul>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-14 max-w-5xl mx-auto">
    {categories.map((cat) => (
      <button
        class="category-icon flex flex-col items-center gap-2 rounded-xl border border-[#43729a]/30 p-4 hover:bg-[#43729a]/10 transition"
        data-category={cat.name}
      >
        <span class="text-3xl">{cat.icon}</span>
        <span class="text-sm font-semibold text-center">{cat.name}</span>
      </button>
    ))}
  </div>

  <div class="grid sm:grid-cols-[220px_1fr] gap-10 max-w-5xl mx-auto">
    <aside>
      <h3 class="font-display font-bold mb-3">Categories</h3>
      <ul class="flex flex-col gap-1">
        <li>
          <button class="sidebar-filter w-full text-left px-3 py-2 rounded-lg font-semibold bg-[#43729a] text-white" data-category="All">
            All
          </button>
        </li>
        {categories.map((cat) => (
          <li>
            <button class="sidebar-filter w-full text-left px-3 py-2 rounded-lg hover:bg-[#43729a]/10" data-category={cat.name}>
              {cat.name}
            </button>
          </li>
        ))}
      </ul>
    </aside>

    <div id="resource-grid" class="grid sm:grid-cols-2 gap-4">
      {resources.map((r) => (
        <div class="resource-card border border-[#43729a]/30 bg-[#43729a]/10 hover:bg-[#43729a]/20 rounded-xl p-4 transition-colors" data-category={r.category}>
          <span class="text-xs font-bold uppercase tracking-wide opacity-70">{r.category} · {r.scope}</span>
          {r.url ? (
            <a href={r.url} class="block mt-1 font-semibold underline">{r.label}</a>
          ) : (
            <p class="mt-1 font-semibold">{r.label}</p>
          )}
        </div>
      ))}
    </div>
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLElement>(".sidebar-filter, .category-icon");
    const cards = document.querySelectorAll<HTMLElement>(".resource-card");
    const sidebarButtons = document.querySelectorAll<HTMLElement>(".sidebar-filter");

    function applyFilter(category: string) {
      cards.forEach((card) => {
        card.style.display = (category === "All" || card.dataset.category === category) ? "" : "none";
      });
      sidebarButtons.forEach((btn) => {
        const isActive = btn.dataset.category === category;
        btn.classList.toggle("bg-[#43729a]", isActive);
        btn.classList.toggle("text-white", isActive);
      });
      document.getElementById("resource-grid")?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const category = btn.dataset.category!;
        applyFilter(category);
      });
    });
  </script>
</BaseLayout>