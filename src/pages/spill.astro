---
import BaseLayout from "../layouts/BaseLayout.astro";

const FORM_SUBMISSIONS_DISABLED = true;
const DISABLED_MESSAGE = "Badger Spill is on break and not currently accepting spills. You're welcome to visit our resources page! For inquiries, email president.badgerspill@gmail.com.";
---

<BaseLayout includeCaptcha={true}>
  <script>
    function setSubmitMessage(message: string) {
      document.getElementById("submit-message")!.textContent = message;
    }

    function setSubmitMessageColor(success: boolean) {
      const successColor = "text-green-600";
      const failColor = "text-red-500";
      document.getElementById("submit-message")?.classList.remove("hidden");

      if (success) {
        document.getElementById("submit-message")?.classList.remove(failColor);
        document.getElementById("submit-message")?.classList.add(successColor);
      } else {
        document.getElementById("submit-message")?.classList.remove(successColor);
        document.getElementById("submit-message")?.classList.add(failColor);
      }
    }

    document
      .getElementById("spill-form")
      ?.addEventListener("submit", function (event) {
        event.preventDefault();
        if (event.target == null) return;
        const formData = new FormData(
          document.getElementById("spill-form") as HTMLFormElement
        );
        const formDataObject: { [key: string]: string } = {};

        formData.forEach((value, key) => {
          formDataObject[key] = value.toString();
        });

        const isDev = import.meta.env.DEV;
        const formUrl = isDev ? "http://localhost:8787/spill" : "https://worker.thebadgerspill.com/spill"

        fetch(formUrl, {
          method: "POST",
          body: JSON.stringify(formDataObject),
          headers: { "Content-Type": "application/json" },
        })
          .then((res) => {
            // @ts-ignore
            grecaptcha.reset();
            if (res.status != 200) {
              setSubmitMessageColor(false);
            } else {
              setSubmitMessageColor(true);
              (document.getElementById("email")! as HTMLFormElement).value = "";
              (document.getElementById("message")! as HTMLFormElement).value = "";
            }
            return res.text();
          })
          .then((resText) => setSubmitMessage(resText))
          .catch((error) => {
            console.error(error);
            // @ts-ignore
            grecaptcha.reset();
            setSubmitMessageColor(false);
            setSubmitMessage("\nCouldn't submit form. Please email dev.badgerspill@gmail.com so we can investigate and fix our server issues!");
          });
      });
  </script>

  <div class="text-center max-w-xl mx-auto mb-10">
    <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl mb-4">
      Spill it.
    </h1>
    <p class="text-lg">
      100% anonymous. A trained Badger will respond to your message within 48 hours.
    </p>
  </div>

  {FORM_SUBMISSIONS_DISABLED &&
    <p class="mt-8 text-lg text-center max-w-xl mx-auto">{DISABLED_MESSAGE}</p>
  }

  {!FORM_SUBMISSIONS_DISABLED &&
    <div class="max-w-xl mx-auto rounded-2xl border-2 border-[#43729a] bg-white/60 p-8">
      <form id="spill-form">
        <div class="w-full">
          <label for="email" class="mb-1 block text-sm font-semibold">Wisc Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@wisc.edu"
            class="block w-full rounded-lg border-2 border-[#43729a]/40 bg-white px-3 py-2.5 placeholder:opacity-50 focus:border-[#43729a] focus:outline-none focus:ring-2 focus:ring-[#43729a]/30"
          />
        </div>

        <div class="mt-5">
          <label for="message" class="mb-1 block text-sm font-semibold">Message</label>
          <textarea
            id="message"
            name="message"
            rows="8"
            placeholder="Write your message here. A volunteer Badger will reply to your anonymous message within 48 hours!"
            class="block w-full rounded-lg border-2 border-[#43729a]/40 bg-white p-3 placeholder:opacity-50 focus:border-[#43729a] focus:outline-none focus:ring-2 focus:ring-[#43729a]/30"
          ></textarea>
        </div>

        <p class="mt-3 text-xs opacity-80">
          Your message will be sent anonymously. Badger Spill reserves the right to
          break confidentiality if our team believes that your safety or
          the safety of others may be at risk. By submitting this form, you agree to
          our <a href="/terms-of-use" class="underline font-semibold">Terms of Use</a>.
        </p>

        <div class="flex flex-col mt-5 sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="g-recaptcha" data-sitekey="6LcduFYpAAAAAAHWZthJQ2MXuJcS5x6TpLCEgBco"></div>
          <button
            id="submit"
            type="submit"
            class="rounded-full bg-[#43729a] px-8 py-3 text-white font-semibold hover:bg-[#365c7d] transition"
          >
            Spill →
          </button>
        </div>
        <p id="submit-message" class="mt-3 text-xs"></p>
      </form>
    </div>
  }
</BaseLayout>